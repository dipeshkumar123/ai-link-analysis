# ---------------------------------------------------------------------------
# LLM configuration
# ---------------------------------------------------------------------------
# Supported providers: groq | openai | gemini | anthropic | deepseek | openrouter | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Optional automatic fallback (used if the primary provider fails or is rate-limited)
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini (https://aistudio.google.com/api-keys)
# Recommended production alternative: gemini-3.5-flash-lite
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Local Ollama (no key required)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# LLM tuning
# ---------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=3500
LLM_REASONING_EFFORT=low
LLM_MAX_RETRIES=0

# ---------------------------------------------------------------------------
# Website extraction
# ---------------------------------------------------------------------------
FETCH_TIMEOUT_SECONDS=15
MAX_PAGE_BYTES=2000000
MAX_REDIRECTS=5
MAX_INPUT_CHARS=6500
USER_AGENT=LinkAnalysisBot/1.0 (+https://github.com/dipeshkumar123/ai-link-analysis)

# ---------------------------------------------------------------------------
# API behaviour
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=*
RATE_LIMIT_PER_HOUR=60
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
# CACHE_PATH=data/cache.sqlite3
ALLOW_PRIVATE_HOSTS=false
